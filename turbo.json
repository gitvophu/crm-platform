{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.base.json", "eslint.config.mjs", "vitest.config.ts"],
  "tasks": {
    "generate": {
      "inputs": ["prisma/schema/**", "prisma.config.ts"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "generate"]
    },
    "lint": {
      "dependsOn": ["^build", "generate"]
    },
    "test": {
      "dependsOn": ["^build", "generate"],
      "passThroughEnv": ["DATABASE_URL", "TEST_DATABASE_URL"]
    },
    "@crm/api#test": {
      "dependsOn": ["^build", "generate"],
      "passThroughEnv": ["DATABASE_URL", "TEST_DATABASE_URL"],
      "cache": false
    }
  }
}
