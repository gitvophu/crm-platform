{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Vite bundles the web app, so imports follow bundler rules: no file extension (slice 0.4, Q6).
    "module": "preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["vite/client"],
    "noEmit": true,
    // `@/x` = `src/x` (slice 0.6, Q8). Vite and Vitest read it via `resolve.tsconfigPaths`.
    "paths": { "@/*": ["./src/*"] },
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.app.tsbuildinfo"
  },
  "include": ["src"]
}
