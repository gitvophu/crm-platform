// Generator and datasource shared by every module. Each module keeps its models in
// <module>.prisma with @@schema("<module>") (slice 0.3, Q4 and Q12).

generator client {
  provider            = "prisma-client"
  output              = "../../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  // Partial unique index on contacts (slice 1.3): one email per team among active contacts.
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["contacts", "identity"]
}
