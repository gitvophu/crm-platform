# Cấu hình local cho docker compose. Tạo file .env: cp .env.example .env
# Các giá trị này chỉ dùng ở máy dev, không phải secret.

POSTGRES_USER=crm
POSTGRES_PASSWORD=crm
POSTGRES_DB=crm

# Host `postgres` là tên service trong compose.yaml.
DATABASE_URL=postgresql://crm:crm@postgres:5432/crm
# DB riêng cho integration test, tạo bởi docker/postgres/init/01-test-db.sql.
TEST_DATABASE_URL=postgresql://crm:crm@postgres:5432/crm_test

# Ký access token (ADR-0004), tối thiểu 32 ký tự. Giá trị dưới chỉ cho máy dev.
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789
# Cookie đăng nhập có cờ Secure (mặc định true). Đặt false khi mở web qua http từ máy khác
# (http://192.168.x.x:5173) hoặc dùng Safari, vì các trường hợp này bỏ cookie Secure trên http.
# COOKIE_SECURE=false

PORT=3000
LOG_LEVEL=info
